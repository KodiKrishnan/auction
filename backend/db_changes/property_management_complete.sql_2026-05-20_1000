-- ============================================================
-- STEP 1 : CREATE TABLES
-- ============================================================

-- 1.1 property_types
CREATE TABLE property_types (
    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
    name       VARCHAR(100) NOT NULL,
    status     TINYINT DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 1.2 locations
-- Note: pincode removed from this table, moved to properties table
-- Note: status column not included as location data is fixed
CREATE TABLE locations (
    id      BIGINT AUTO_INCREMENT PRIMARY KEY,
    country VARCHAR(100) NOT NULL,
    state   VARCHAR(100) NOT NULL,
    city    VARCHAR(100) NOT NULL
);

-- 1.3 amenities
CREATE TABLE amenities (
    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
    name       VARCHAR(100) NOT NULL,
    icon       VARCHAR(100),
    status     TINYINT DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 1.4 properties
-- Note: pincode added here for property level precision
CREATE TABLE properties (
    id               BIGINT AUTO_INCREMENT PRIMARY KEY,
    owner_id         BIGINT NOT NULL,
    property_type_id BIGINT NOT NULL,
    property_name    VARCHAR(255) NOT NULL,
    description      TEXT,
    location_id      BIGINT NOT NULL,
    address          TEXT,
    pincode          VARCHAR(20),
    latitude         DECIMAL(10,7),
    longitude        DECIMAL(10,7),
    max_guests       INT,
    bedrooms         INT,
    amenity_ids      JSON,
    status           TINYINT DEFAULT 2,
    created_at       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at       TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (owner_id)         REFERENCES property_owners(id),
    FOREIGN KEY (property_type_id) REFERENCES property_types(id),
    FOREIGN KEY (location_id)      REFERENCES locations(id)
);

-- 1.5 property_images
CREATE TABLE property_images (
    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
    property_id BIGINT NOT NULL,
    image_path  TEXT NOT NULL,
    is_primary  BOOLEAN DEFAULT FALSE,
    created_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (property_id) REFERENCES properties(id)
);


