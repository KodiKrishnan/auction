# --- Terraform ---
# Ignore .terraform directory (provider binaries and modules)
**/.terraform/
**/.terraform.lock.hcl

# Ignore state files (contain sensitive data and infrastructure mapping)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.auto.tfvars
terraform.tfstate*
.terraform/
# Ignore crash logs
crash.log
crash.*.log

# Ignore variable files that may contain secrets (optional: keep templates, ignore local overrides)
*.tfvars
*.tfvars.json
!terraform.tfvars.example
# Ignore CLI config
.terraformrc
terraform.rc

# Terraform
.terraform/

*.tfstate
*.tfstate.*

*.tfplan

crash.log

override.tf
override.tf.json

*_override.tf
*_override.tf.json

terraform.tfvars

*.auto.tfvars

# --- Docker ---
# Ignore environment files used by docker-compose
.env
.env.*
!.env.example

# Ignore Docker build artifacts
*.log
.Dockerfile.swp

# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- General Secrets & OS ---
# SSH Keys (never commit these)
*.pem
*.key
id_rsa
id_rsa.pub

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db   
