{
  "family": "nivasabid-uat-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::195733158591:role/nivasabid-uat-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::195733158591:role/nivasabid-uat-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "uat"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:mysql://nivasabid-uat-db.c98guq8kkh3l.ap-south-1.rds.amazonaws.com:3306/auctiondb"
        },
        {
          "name": "JWT_SECRET",
          "value": "__JWT_SECRET__"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "value": "__GOOGLE_CLIENT_ID__"
        }
        
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:195733158591:secret:rds!db-a636c7e4-7c78-47d5-8a2d-c25031ac5d8b-yQfN2P:username::"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:195733158591:secret:rds!db-a636c7e4-7c78-47d5-8a2d-c25031ac5d8b-yQfN2P:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nivasabid-uat-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
